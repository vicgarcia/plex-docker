# Timezone (e.g. America/New_York, America/Los_Angeles)
TZ=America/New_York

# One-time claim token to register the server with your Plex account.
# Get one at https://www.plex.tv/claim — expires in 4 minutes.
# Leave blank after first run.
PLEX_CLAIM=

# UID/GID of the user that owns your media files on the host.
# Run `id` in your shell to find these values.
PLEX_UID=
PLEX_GID=

# Path to media files on the host
PLEX_MEDIA_DIR=/path/to/media
